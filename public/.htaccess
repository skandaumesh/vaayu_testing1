RewriteEngine On
RewriteBase /

# ---------------------------------------------------------------------------
# 1. Canonical host. www and the apex both used to answer 200, which split
#    duplicate signals across two hostnames.
# ---------------------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ---------------------------------------------------------------------------
# 2. Legacy WordPress URLs. These predate the React site and still had live
#    entries in Google's index, answering 200 with the homepage. Redirect them
#    so historical link equity lands on the real page.
#    Extend this list from the Search Console Pages report.
# ---------------------------------------------------------------------------
RewriteRule ^contact-us/?$ /contact [R=301,L]
RewriteRule ^about-us/?$ /about [R=301,L]
RewriteRule ^services/?$ /specialty-clinic [R=301,L]
RewriteRule ^our-team/?$ /about [R=301,L]
RewriteRule ^book-appointment/?$ /appointment [R=301,L]

# ---------------------------------------------------------------------------
# 3. Route casing. Two routes are declared with capitals in the router; the
#    prerendered shells and canonicals are lowercase, so send the mixed-case
#    forms to the canonical one.
# ---------------------------------------------------------------------------
RewriteRule ^Allied-services/?$ /allied-services [R=301,L]
RewriteRule ^Procedural-Training/?$ /procedural-training [R=301,L]

RewriteRule ^index\.html$ - [L]

# ---------------------------------------------------------------------------
# 4. Serve the prerendered shell for a route when one exists.
#    scripts/gen-route-shells.mjs writes dist/<route>.html for every route in
#    the router, each carrying its own title, description, canonical and
#    JSON-LD. React mounts on top of it for real browsers.
# ---------------------------------------------------------------------------
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# ---------------------------------------------------------------------------
# 5. Anything left is genuinely unknown. Previously every path on the site,
#    including nonsense ones, fell through to index.html and answered 200,
#    which Google treats as a soft 404 and crawls indefinitely.
#    Every real route has a shell from rule 4, so falling through to here
#    means the URL does not exist.
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]

# Cache static assets aggressively (Vite fingerprints them)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# HTML shells must not be cached long: they carry the SEO tags and are
# regenerated on every build.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
